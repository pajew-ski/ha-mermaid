{
  "name": "ha-mermaid",
  "version": "0.8.1",
  "description": "Home Assistant custom card for rendering Mermaid diagrams with full theme integration",
  "main": "dist/ha-mermaid.js",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "lint": "eslint src",
    "test": "node scripts/check-version.mjs && node --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pajew-ski/ha-mermaid"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "mermaid",
    "diagram",
    "custom-card"
  ],
  "author": "pajew-ski",
  "license": "MIT",
  "dependencies": {
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "lit": "^3.3.3",
    "rollup": "^4.68.0",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
